# GovConnect - Environment Configuration Template
# Unified Government Service Interoperability Platform

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=govconnect_secure_platform_jwt_secret_key_2026_prod
JWT_REFRESH_SECRET=govconnect_secure_platform_refresh_secret_key_2026_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Settings (Optional for verification simulation)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GovConnect Support <no-reply@govconnect.gov.in>"

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ==============================================================================
# DigiLocker / API Setu Requester Integration Configuration
# ==============================================================================
# Integration Modes:
#   1. REAL_AUTHORIZED - Connects to official DigiLocker / API Setu Requester Gateway
#      Requires valid DIGILOCKER_CLIENT_ID and DIGILOCKER_CLIENT_SECRET.
#   2. REPRESENTATIVE   - Local standardized representative environment (default fallback)
#   3. NOT_CONFIGURED   - Declares DigiLocker integration disabled, enables manual fallback
# ==============================================================================
DIGILOCKER_MODE=REPRESENTATIVE
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/integrations/digilocker/callback
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in

# Initial Central Administrator Credentials (For secure platform bootstrap)
INITIAL_ADMIN_EMAIL=admin@govconnect.demo
INITIAL_ADMIN_PASSWORD=Password@123
