# ==========================================
# GOVCONNECT SIH26129 - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (SQLite default for zero-setup local dev, PostgreSQL ready)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/govconnect?schema=public"

# JWT Authentication Secrets (Generate secure random strings for production)
JWT_SECRET=govconnect_super_secure_jwt_secret_key_2026_sih
JWT_REFRESH_SECRET=govconnect_super_secure_refresh_secret_key_2026_sih
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Configuration (Optional - in dev mode, verification links & reset tokens are logged to server console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GovConnect Support <no-reply@govconnect.gov.in>"

# File Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
