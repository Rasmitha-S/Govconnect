# ==============================================================================
# GOVCONNECT - VERCEL & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or add the appropriate variables in Vercel Project Settings.
# DO NOT commit real secrets, private keys, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------------------------------------------
# In unified single-project Vercel deployment, leave VITE_API_URL empty/unset (defaults to /api).
# If deploying frontend and backend as separate Vercel projects, set to backend domain:
# VITE_API_URL=https://your-govconnect-backend.vercel.app
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Web URL for CORS validation and email action redirect links
FRONTEND_URL=https://your-govconnect-app.vercel.app
# Additional comma-separated allowed CORS origins (optional)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Vercel Serverless / Hosted Production Database (PostgreSQL / Supabase / Neon / Turso / Railway):
# DATABASE_URL="postgresql://user:password@host:5432/govconnect?sslmode=require"

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Set long, cryptographically random strings in Vercel Environment Variables
JWT_SECRET=your_production_jwt_secret_key_min_32_characters
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_min_32_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. INITIAL PLATFORM ADMINISTRATOR (BOOTSTRAP)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@govconnect.demo
INITIAL_ADMIN_PASSWORD=Password@123

# ------------------------------------------------------------------------------
# 6. SMTP / EMAIL SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GovConnect Support <no-reply@govconnect.gov.in>"

# ------------------------------------------------------------------------------
# 7. FILE STORAGE / UPLOADS
# ------------------------------------------------------------------------------
# Serverless environments use /tmp/uploads automatically
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 8. DIGILOCKER / API SETU INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Integration Modes: REAL_AUTHORIZED | REPRESENTATIVE | NOT_CONFIGURED
DIGILOCKER_MODE=REPRESENTATIVE
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://your-govconnect-app.vercel.app/api/integrations/digilocker/callback
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in
