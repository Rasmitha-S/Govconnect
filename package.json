{
  "name": "govconnect-platform",
  "version": "1.0.0",
  "private": true,
  "description": "GovConnect SIH26129 - Unified Government Service Interoperability Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run prisma:generate && npm --prefix backend run build && npm --prefix frontend run build",
    "vercel-build": "npm --prefix backend run prisma:generate && npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "seed": "npm --prefix backend run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@vercel/node": "^3.2.32",
    "prisma": "^5.22.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "sih2026",
    "govconnect",
    "interoperability",
    "e-governance",
    "vercel"
  ],
  "author": "GovConnect SIH Team",
  "license": "MIT"
}
